# ─── Copy file này sang .env.local rồi điền giá trị thật. KHÔNG commit .env.local ───

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Đa ngôn ngữ (i18n) — mã BCP-47, phân tách bằng dấu phẩy
# vi=Việt en=Anh zh=Trung ja=Nhật ko=Hàn fr=Pháp de=Đức id=Indonesia hi=Ấn(Hindi) th=Thái
SUPPORTED_LOCALES=vi,en,zh,ja,ko,fr,de,id,hi,th
DEFAULT_LOCALE=vi

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/seogeo

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# ─── Worker lịch đăng (npm run worker) ───
# Bí mật để worker/cron gọi POST /api/jobs/run (header x-cron-secret). Sinh: openssl rand -hex 16
CRON_SECRET=
# Khoảng quét job đến hạn (ms). Mặc định 60000.
WORKER_INTERVAL_MS=60000

# Mã hóa credential CMS (32 bytes, base64) — sinh bằng: openssl rand -base64 32
ENCRYPTION_KEY=

# ─── Nhà cung cấp AI (có thể nhập trong app: Cài đặt → API Keys & AI) ───
# Để trống cũng được — app chạy mock; nhập key ở UI sẽ lưu mã hóa ở .data/
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
CLAUDE_MODEL_WRITER=claude-opus-4-8
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# ─── Keyword data provider (DataForSEO mặc định) ───
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ─── Audit website: Core Web Vitals (tùy chọn) ───
# Lấy key tại Google Cloud (PageSpeed Insights API). Để trống vẫn chạy được (giới hạn tần suất).
PAGESPEED_API_KEY=

# ─── WordPress (cấu hình mặc định/test; site thật lưu trong DB Connection) ───
# Tạo Application Password trong WP: Users → Profile → Application Passwords
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# ─── Wix ───
# Tạo app/API key tại dev.wix.com; cần quyền Blog & SEO
WIX_API_KEY=
WIX_SITE_ID=
WIX_ACCOUNT_ID=
