# App
NODE_ENV=development
# URL công khai của app. QUAN TRỌNG cho Shopify/Wix: ảnh do app tự sinh (public/generated/)
# được tham chiếu qua {APP_URL}/generated/... nên APP_URL phải là domain CÔNG KHAI (không phải
# localhost) thì ảnh mới hiện trên Shopify/Wix. WordPress không cần (upload bytes trực tiếp).
APP_URL=http://localhost:3000

SOCIAL_PUBLISH_ALLOWED_ORIGINS=https://nextg.nextgency.vn/

# ─── SaaS: Superadmin (chủ nền tảng) ───
# Danh sách email superadmin, phân tách bằng dấu phẩy. Superadmin LUÔN ở gói Enterprise (không
# giới hạn) và vào được trang Quản trị nền tảng /admin. BẮT BUỘC đặt email của chủ, nếu không
# chính chủ cũng bị coi là khách thường → rớt Free sau 14 ngày dùng thử.
SUPERADMIN_EMAILS=schhung2143@gmail.com

# Đa ngôn ngữ (i18n) — mã BCP-47, phân tách bằng dấu phẩy
# vi=Việt en=Anh zh=Trung ja=Nhật ko=Hàn fr=Pháp de=Đức id=Indonesia hi=Ấn(Hindi) th=Thái
SUPPORTED_LOCALES=vi
DEFAULT_LOCALE=vi

# ─── Kho lưu trữ ───
# Backend dữ liệu: 'file' (mặc định — .data/*.json, chỉ 1 instance) | 'prisma' (Postgres, đa-instance).
# CHỈ đặt 'prisma' SAU khi đã tạo bảng + nạp dữ liệu (xem docs/POSTGRES-MIGRATION.md). Bỏ = quay lại file.
STORAGE_DRIVER=prisma

# Database (PostgreSQL) — cần khi STORAGE_DRIVER=prisma. Trong Docker, mật khẩu lấy từ POSTGRES_PASSWORD.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=
# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# ─── Worker lịch đăng (npm run worker) ───
# Bí mật để worker/cron gọi POST /api/jobs/run (header x-cron-secret). Sinh: openssl rand -hex 16
CRON_SECRET=
WORKER_INTERVAL_MS=60000

ENCRYPTION_KEY=

# ─── Nhà cung cấp AI (có thể nhập trong app: Cài đặt → API Keys & AI) ───
# Để trống cũng được — app chạy mock; nhập key ở UI sẽ lưu mã hóa ở .data/
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# CLAUDE_MODEL_WRITER=claude-opus-4-8
# CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# # â”€â”€â”€ Keyword data provider (DataForSEO máº·c Ä‘á»‹nh) â”€â”€â”€
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# # ─── Audit website: Core Web Vitals (tùy chọn) ───
# # Lấy key tại Google Cloud (PageSpeed Insights API). Để trống vẫn chạy được (giới hạn tần suất).
# PAGESPEED_API_KEY=

# # ─── Báo cáo Social: Apify (tùy chọn - có thể nhập ở Quản lý kết nối thay vì env) ───
# # Lấy token tại console.apify.com → Settings → API & Integrations.
# APIFY_API_TOKEN=

# # ─── WordPress (cấu hình mặc định/test; site thật lưu trong DB Connection) ───
# # Tạo Application Password trong WP: Users → Profile → Application Passwords
# WORDPRESS_BASE_URL=
# WORDPRESS_USERNAME=
# WORDPRESS_APP_PASSWORD=

# # ─── Wix ───
# # Tạo app/API key tại dev.wix.com; cần quyền Blog & SEO
# WIX_API_KEY=
# WIX_SITE_ID=
# WIX_ACCOUNT_ID=
