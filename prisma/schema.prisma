generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Tài khoản và phiên đăng nhập của hệ thống single-workspace.
model User {
  id                String    @id
  email             String    @unique
  name              String    @db.Text
  role              String    @db.Text
  passwordHash      String    @db.Text
  salt              String    @db.Text
  active            Boolean   @default(true)
  permissions       Json?
  emailVerified     Boolean   @default(true)
  firstTouchUtm     Json?
  lastTouchUtm      Json?
  fbp               String?   @db.VarChar(255)
  fbc               String?   @db.VarChar(255)
  ttclid             String?   @db.VarChar(255)
  ttp                String?   @db.VarChar(255)
  gclid              String?   @db.VarChar(255)
  gaClientId         String?   @db.VarChar(255)
  landingPage        String?   @db.Text
  referrer           String?   @db.Text
  signupIp           Bytes?    @db.VarBinary(16)
  signupUserAgent    String?   @db.Text
  lastIp             Bytes?    @db.VarBinary(16)
  lastUserAgent      String?   @db.Text
  lastSeenAt         DateTime?
  createdAt          DateTime  @default(now())

  consents   UserConsent[]
  events     UserEvent[]
  activities UserSessionActivity[]

  @@index([createdAt])
  @@index([lastSeenAt])
  @@index([fbp])
  @@index([fbc])
  @@index([ttclid])
  @@index([gclid])
}

model Session {
  token     String   @id
  userId    String
  expiresAt DateTime

  @@index([userId])
}

model PlatformConfig {
  key   String @id
  value Json
}

// Dữ liệu nghiệp vụ không còn khóa tenant/biz và chỉ dùng tiếng Việt.
model Connection {
  id        String   @id
  provider  String   @db.Text
  label     String   @db.Text
  baseUrl   String   @db.Text
  seoPlugin String?  @db.Text
  encrypted String   @db.LongText
  status    String   @default("active")
  createdAt DateTime @default(now())
}

model Article {
  id              String   @id
  title           String   @db.Text
  slug            String   @default("")
  metaDescription String   @db.LongText
  markdown        String   @db.LongText
  targetKeyword   String?  @db.Text
  tags            Json?
  categories      Json?
  coverImageUrl   String?  @db.Text
  source          String   @default("new")
  seoScore        Int      @default(0)
  aeoScore        Int      @default(0)
  geoScore        Int      @default(0)
  status          String   @default("draft")
  approved        Boolean?
  reviewNote      String?  @db.Text
  submittedBy     String?  @db.Text
  reviewedBy      String?  @db.Text
  assignedTo      String?  @db.Text
  connectionId    String?  @db.Text
  cmsPostId       String?  @db.Text
  publishedUrl    String?  @db.Text
  updatedAt       DateTime @default(now())

  @@index([status])
}

model KeywordSet {
  id        String   @id
  seed      String   @db.Text
  estimated Boolean  @default(false)
  keywords  Json
  clusters  Json
  createdAt DateTime @default(now())
}

model ContentPlan {
  id           String   @id
  keywordSetId String   @db.Text
  title        String   @db.Text
  seed         String   @db.Text
  items        Json
  createdAt    DateTime @default(now())
}

model Revision {
  id              String   @id
  connectionId    String   @db.Text
  cmsPostId       String
  title           String   @db.Text
  contentHtml     String   @db.LongText
  metaDescription String?  @db.Text
  snapshotOk      Boolean  @default(false)
  reason          String   @db.Text
  createdAt       DateTime @default(now())

  @@index([cmsPostId])
}

model PublishJob {
  id           String    @id
  connectionId String    @db.Text
  article      Json
  articleId    String?   @db.Text
  status       String
  runAt        DateTime?
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  lastError    String?   @db.Text
  resultPostId String?   @db.Text
  resultUrl    String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  @@index([status])
}

model Comment {
  id        String   @id
  articleId String
  userId    String   @db.Text
  userName  String   @db.Text
  body      String   @db.LongText
  createdAt DateTime @default(now())

  @@index([articleId])
}

model ApiToken {
  id         String    @id
  name       String    @db.Text
  prefix     String    @db.Text
  hash       String
  createdBy  String    @db.Text
  lastUsedAt DateTime?
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([hash])
}

model AiUsage {
  key       String @id
  provider  String @db.Text
  model     String @db.Text
  inTokens  Int    @default(0)
  outTokens Int    @default(0)
  calls     Int    @default(0)
  images    Int    @default(0)
}

model AiUsageSeries {
  date      String
  key       String
  provider  String @db.Text
  model     String @db.Text
  inTokens  Int    @default(0)
  outTokens Int    @default(0)
  images    Int    @default(0)

  @@id([date, key])
  @@index([date])
}

model AiUsageByUser {
  userId    String @id
  inTokens  Int    @default(0)
  outTokens Int    @default(0)
}

model Citation {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
}

// JsonBlob là backend runtime chính. Mọi dữ liệu dùng scope "_global".
model JsonBlob {
  scope     String
  name      String
  data      Json
  version   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@id([scope, name])
}

model UserEvent {
  id          String   @id
  userId      String?
  anonymousId String?
  sessionId   String?
  eventName   String   @db.VarChar(128)
  eventType   String   @default("interaction")
  area        String?
  path        String?  @db.VarChar(512)
  routeName   String?
  entityType  String?
  entityId    String?
  source      String?
  value       Decimal? @db.Decimal(18, 4)
  currency    String?  @db.VarChar(16)
  durationMs  Int?
  success     Boolean?
  errorCode   String?
  metadata    Json?
  ip          Bytes?   @db.VarBinary(16)
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([eventName, createdAt])
  @@index([area, createdAt])
  @@index([path, createdAt])
  @@index([createdAt])
}

model UserSessionActivity {
  id          String    @id
  userId      String?
  anonymousId String?
  sessionId   String    @unique
  startedAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  endedAt     DateTime?
  entryPath   String?   @db.Text
  landingPage String?   @db.Text
  referrer    String?   @db.Text
  utm         Json?
  fbp         String?   @db.VarChar(255)
  fbc         String?   @db.VarChar(255)
  ttclid      String?   @db.VarChar(255)
  ttp         String?   @db.VarChar(255)
  gclid       String?   @db.VarChar(255)
  gaClientId  String?   @db.VarChar(255)
  ip          Bytes?    @db.VarBinary(16)
  userAgent   String?   @db.Text
  deviceType  String?   @db.VarChar(64)
  browser     String?   @db.VarChar(128)
  os          String?   @db.VarChar(128)
  country     String?   @db.VarChar(2)
  region      String?   @db.VarChar(128)
  city        String?   @db.VarChar(128)
  pageViews   Int       @default(0)
  events      Int       @default(0)
  metadata    Json?

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, lastSeenAt])
  @@index([anonymousId])
  @@index([fbp])
  @@index([fbc])
  @@index([ttclid])
  @@index([gclid])
}

model DailyUsageMetric {
  date            DateTime @db.Date
  userId          String   @default("") @db.VarChar(64)
  area            String   @db.VarChar(96)
  eventName       String   @db.VarChar(128)
  pathHash        Bytes    @db.Binary(16)
  path            String?  @db.VarChar(512)
  count           Int      @default(0)
  uniqueUsers     Int      @default(0)
  uniqueSessions  Int      @default(0)
  totalDurationMs BigInt   @default(0)
  updatedAt       DateTime @default(now()) @updatedAt

  @@id([date, area, eventName, pathHash, userId])
  @@index([userId, date])
  @@index([area, date])
}

model UserConsent {
  id          String   @id
  userId      String?
  anonymousId String?
  sessionId   String?
  analytics   Boolean  @default(false)
  marketing   Boolean  @default(false)
  necessary   Boolean  @default(true)
  source      String?
  ip          Bytes?   @db.VarBinary(16)
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, updatedAt])
  @@index([anonymousId])
  @@index([sessionId])
}

// Bảng nghiệp vụ độc lập có sẵn trong CSDL, không thuộc mẫu SaaS cần loại bỏ.
model Services {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  created_by   String?   @db.VarChar(255)
  updated_by   String?   @db.VarChar(255)
  nc_order     Decimal?  @db.Decimal(10, 2)
  service_code String?   @db.Text
  service_name String?   @db.Text
  money        BigInt?
  money_sale   BigInt?
  time_start   DateTime? @db.DateTime(0)
  time_end     DateTime? @db.DateTime(0)
  update_time  DateTime? @db.DateTime(0)

  @@index([nc_order], map: "services_order_idx")
}
